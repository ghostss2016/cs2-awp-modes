import os, sys

def ResolveEnvPath(env, folder):
  if env in os.environ:
    path = os.environ[env]
    if os.path.isdir(path):
      return path
  else:
    head = os.getcwd()
    oldhead = None
    while head != None and head != oldhead:
      path = os.path.join(head, folder)
      if os.path.isdir(path):
        return path
      oldhead = head
      head, tail = os.path.split(head)
  return None

def ResolveMMSRoot():
  prenormalized_path = None
  if builder.options.mms_path:
    prenormalized_path = builder.options.mms_path
  else:
    prenormalized_path = ResolveEnvPath('MMSOURCE_DEV', 'metamod-source')
  if not prenormalized_path or not os.path.isdir(prenormalized_path):
    raise Exception('Could not find a source copy of Metamod:Source')

  return os.path.abspath(os.path.normpath(prenormalized_path))

mms_root = ResolveMMSRoot()

hl2sdk_manifests = os.path.join(builder.sourcePath, 'hl2sdk-manifests')

SdkHelpers = builder.Eval(os.path.join(hl2sdk_manifests, 'SdkHelpers.ambuild'), {
  'Project': 'metamod'
})

class MMSPluginConfig(object):
  def __init__(self):
    self.sdks = {}
    self.sdk_targets = []
    self.binaries = []
    self.mms_root = mms_root
    self.all_targets = []
    self.target_archs = set()

    self.plugin_name = 'cs2-awp-modes'
    self.plugin_alias = 'cs2-awp-modes'

    target_archs = ['x86_64']

    for arch in target_archs:
        try:
            cxx = builder.DetectCxx(target_arch = arch)
            self.target_archs.add(cxx.target.arch)
        except Exception as e:
            print('Skipping target {}: {}'.format(arch, e))
            continue
        self.all_targets.append(cxx)

    if not self.all_targets:
        raise Exception('No suitable C/C++ compiler was found.')

  def findSdkPath(self, sdk_name):
    dir_name = 'hl2sdk-{}'.format(sdk_name)
    if builder.options.hl2sdk_root:
      sdk_path = os.path.join(builder.options.hl2sdk_root, dir_name)
      if os.path.exists(sdk_path):
        return sdk_path
    return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), dir_name)

  def detectSDKs(self):
    sdk_list = ['cs2']
    SdkHelpers.find_sdk_path = self.findSdkPath
    SdkHelpers.findSdks(builder, self.all_targets, sdk_list)
    self.sdks = SdkHelpers.sdks
    self.sdk_targets = SdkHelpers.sdk_targets

  def configure(self):
    for cxx in self.all_targets:
      self.configure_cxx(cxx)

  def configure_cxx(self, cxx):
    if cxx.like('gcc'):
      cxx.defines += [
        'stricmp=strcasecmp',
        '_stricmp=strcasecmp',
        '_snprintf=snprintf',
        '_vsnprintf=vsnprintf',
        'HAVE_STDINT_H',
        'GNUC',
      ]
      cxx.cflags += [
        '-pipe',
        '-fno-strict-aliasing',
        '-Wall',
        '-Wno-uninitialized',
        '-Wno-unused',
        '-Wno-switch',
        '-msse',
        '-fPIC',
        '-fvisibility=hidden',
      ]
      cxx.cxxflags += [
        '-std=c++17',
        '-fno-exceptions',
        '-fno-threadsafe-statics',
        '-fvisibility-inlines-hidden',
        '-Wno-non-virtual-dtor',
        '-Wno-overloaded-virtual',
        '-Wno-register',
        '-Wno-delete-non-virtual-dtor',
        '-Wno-invalid-offsetof',
      ]

      if cxx.like('clang'):
        cxx.linkflags += ['-lgcc_eh']
      else:
        cxx.linkflags += ['-static-libgcc']
      cxx.linkflags += ['-m64', '-lm', '-ldl', '-static-libstdc++',
                        '-Wl,--wrap=pthread_once',
                        '-Wl,--wrap=pthread_join',
                        '-Wl,--wrap=pthread_create',
                        '-Wl,--wrap=pthread_detach',
                        '-Wl,--wrap=__pthread_key_create',
                        '-Wl,--wrap=fstat64',
                        '-Wl,--wrap=fmodf',
                        '-Wl,--wrap=dlopen',
                        '-Wl,--wrap=dlclose',
                        '-Wl,--wrap=dlsym',
                        '-Wl,--wrap=dladdr',
                        '-Wl,--wrap=dlinfo',
                        '-Wl,--version-script=' + os.path.join(builder.sourcePath, 'exports.map')]

    if cxx.target.platform == 'linux':
      cxx.defines += ['LINUX', '_LINUX', 'POSIX', '_FILE_OFFSET_BITS=64']

    cxx.defines += ['META_IS_SOURCE2']

  def HL2Compiler(self, context, cxx, sdk):
    compiler = cxx.Clone()
    SdkHelpers.configureCxx(context, compiler, sdk)

    return compiler

  def AddVersioning(self, binary):
    pass

  def Library(self, cxx, name):
    binary = cxx.Library(name)
    return binary

  def HL2Library(self, context, compiler, name, sdk):
    binary = self.Library(compiler, name)
    mms_core_path = os.path.join(self.mms_root, 'core')
    cxx = binary.compiler

    cxx.cxxincludes += [
      os.path.join(context.currentSourcePath),
      os.path.join(context.currentSourcePath, 'src'),
      os.path.join(context.currentSourcePath, 'include'),
      os.path.join(mms_core_path),
      os.path.join(mms_core_path, 'sourcehook'),
    ]

    for other_sdk in SdkHelpers.sdk_manifests:
      cxx.defines += ['SE_{}={}'.format(other_sdk['define'], other_sdk['code'])]

    cxx.defines += ['META_IS_SOURCE2']
    binary.sources += [
      os.path.join(sdk['path'], 'public', 'tier0', 'memoverride.cpp'),
    ]

    SdkHelpers.configureCxx(context, binary, sdk)

    return binary

MMSPlugin = MMSPluginConfig()
MMSPlugin.detectSDKs()
MMSPlugin.configure()

builder.Build('cs2-awp-modes.build.py', { 'MMSPlugin': MMSPlugin, 'SdkHelpers': SdkHelpers })
